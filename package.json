{
  "name": "pix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:types": "vp check --no-fmt",
    "fmt": "vp check --fix",
    "ready": "pnpm check && pnpm test && pnpm build",
    "version:set": "node scripts/set-version.mjs",
    "test": "vp run --no-cache -r test",
    "build": "vp run -r build",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "vp run --no-cache @pix/desktop#dev",
    "build:desktop": "vp run --no-cache @pix/desktop#build",
    "start:desktop": "vp run --no-cache @pix/desktop#start",
    "dev:landing": "vp run --no-cache @pix/landing#dev",
    "build:landing": "vp run --no-cache @pix/landing#build",
    "preview:landing": "vp run --no-cache @pix/landing#preview",
    "electron:install": "vp run --no-cache @pix/desktop#electron:install",
    "smoke": "vp run --no-cache @pix/desktop#smoke",
    "smoke:packaged": "vp run --no-cache @pix/desktop#smoke:packaged",
    "e2e": "vp run --no-cache @pix/desktop#e2e",
    "package": "pnpm package:desktop",
    "package:desktop": "vp run --no-cache @pix/desktop#package",
    "package:dir": "vp run --no-cache @pix/desktop#package:dir"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.15.1"
}
